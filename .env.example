# 0G Network
ZG_API_KEY=your_0g_api_key_here
ZG_RPC=https://evmrpc-testnet.0g.ai

# Whitechain
WHITECHAIN_RPC=https://rpc.ankr.com/whitechain_testnet
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here
CONTRACT_ADDRESS=0xB4491c1eBE47447661B0e1266e19f3B2D32A226f
USDT_ADDRESS=0x377326408765f7CE5ab2757F0F0529B4c785cc47
PROVIDER_ADDRESS=0x91EE9440981f3775ae734b023ecD034fd7274A99
ORACLE_SIGNER_ADDRESS=0x279eBb05E158315Bb92e9749b8BA45c17992B37e

# 0G Storage (optional). When set, the encrypted input is uploaded to 0G Storage; unset = skipped.
# ZG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai

# Arkiv (Rabdi testnet — Kaolin retired May 2026)
ARKIV_RPC=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_ACCESS_KEY=your_arkiv_access_key_here

# Oracle (TEE verification)
ORACLE_PRIVATE_KEY=oracle_signing_key_here

# Cron route protection. The endpoint is closed unless this is set; callers send "Authorization: Bearer <secret>".
# CRON_SECRET=some_random_secret_here

# App
NEXT_PUBLIC_WHITECHAIN_CHAIN_ID=1874
NEXT_PUBLIC_CONTRACT_ADDRESS=0xB4491c1eBE47447661B0e1266e19f3B2D32A226f

# Who pays for jobs. By default a wallet pays from its own balance by signing the job (see frontend/src/lib/auth-message.ts).
# Set both of these to let the service wallet pay instead (demo mode: no wallet needed, but the service balance is spent).
# ALLOW_SERVICE_PAID_JOBS=true
# NEXT_PUBLIC_SERVICE_PAID=true

# Wallet connect. USDT defaults to contracts/deployments/whitechain.json. WalletConnect is optional: browser wallets work without it.
# NEXT_PUBLIC_USDT_ADDRESS=0x377326408765f7CE5ab2757F0F0529B4c785cc47
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

